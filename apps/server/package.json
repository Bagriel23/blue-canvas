{
  "name": "@blue-canvas/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && tsc --build --pretty false",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@blue-canvas/contracts": "0.0.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "fastify": "5.12.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "prisma": "7.9.1"
  }
}
