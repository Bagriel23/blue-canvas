# Development-only defaults. Replace every credential outside local development.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
SETUP_SECRET=replace-with-a-unique-setup-secret
ASSET_STORAGE_ROOT=/tmp/blue-canvas-assets

MARIADB_PORT=3306
MARIADB_DATABASE=blue_canvas
MARIADB_USER=blue_canvas
MARIADB_PASSWORD=blue_canvas_dev
MARIADB_ROOT_PASSWORD=blue_canvas_root_dev

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=blue_canvas
DATABASE_USER=blue_canvas
DATABASE_PASSWORD=blue_canvas_dev

# Web preview port used by the Vite preview server (compose `web` service).
WEB_PORT=4173

# MCP HTTP port for the Blue Canvas MCP server (compose `mcp` service).
MCP_PORT=5011
