{
  "name": "blue-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test:smoke && vitest run",
    "test:export-fixtures": "vitest run --project packages/exporters src/framework-build.test.ts",
    "test:smoke": "node --test tests/foundation.test.mjs",
    "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.0",
    "fast-check": "^4.3.0",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "parse5": "8.0.1",
    "preact": "10.29.8",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
